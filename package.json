{
  "name": "dsh-ming-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "记忆神经元：每条真记忆一个点，每条边都带「凭什么连」的理由，点开能读正文和全部连线",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "neuron.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
